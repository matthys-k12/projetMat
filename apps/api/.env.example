# Copier ce fichier en .env (jamais commité) puis renseigner les valeurs.

# Port HTTP de l'API
PORT=3000

# Projet Supabase : Dashboard > Project Settings > API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Clé service_role : contourne la RLS. SERVEUR UNIQUEMENT.
# Ne jamais la copier dans apps/web ni la commiter.
SUPABASE_SERVICE_ROLE_KEY=

# Origine autorisée par CORS (le front Vite)
WEB_URL=http://localhost:5173

# development | production | test (les stack traces ne sont renvoyées qu'en development)
NODE_ENV=development
