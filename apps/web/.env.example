# Copier ce fichier en .env (jamais commité).
# Toutes les variables VITE_* sont PUBLIQUES : elles finissent dans le JavaScript
# envoyé au navigateur. Ne jamais y mettre la clé service_role.

# URL de l'API (tier métier)
VITE_API_URL=http://localhost:3000/api/v1

# Projet Supabase : Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Clé ANON (publique) : sert uniquement à l'authentification.
# Elle ne donne accès à aucune donnée : la base est en « deny all » (RLS sans policy).
VITE_SUPABASE_ANON_KEY=
